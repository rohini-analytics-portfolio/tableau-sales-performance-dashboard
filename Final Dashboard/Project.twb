              <calculation class='tableau' formula='IF SUM([Calculation_1962410556276742]) = WINDOW_MAX(SUM([Calculation_1962410556276742]))&#13;&#10;THEN SUM([Calculation_1962410556276742])&#13;&#10;ELSEIF SUM([Calculation_1962410556276742]) = WINDOW_MIN(SUM([Calculation_1962410556276742]))&#13;&#10;THEN SUM([Calculation_1962410556276742])&#13;&#10;END'>
